# CloudSidra-Edge data-plane image (standalone for compose/single-node).
# The Edge builds against vendored pingora; use the repo's rust toolchain.
# Build from repo root:  docker build -f deploy/Dockerfile.edge -t cloudsidra-edge:2026.1.08.0 .
FROM rust:1.97-bookworm AS builder
WORKDIR /build
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev clang llvm \
    && rm -rf /var/lib/apt/lists/*
# Copy workspace manifests and heavy vendored subdirs to maximize cache reuse.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY pingora-main ./pingora-main
COPY proto ./proto
COPY proto_defs ./proto_defs
COPY toa-main ./toa-main
COPY toa-sender ./toa-sender
# Vendor is large; only needed if offline. See .cargo/config.toml.
COPY .cargo ./.cargo
COPY src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata iproute2 kmod libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home --home-dir /var/lib/cloudsidra/edge --shell /usr/sbin/nologin cloudsidra-edge
WORKDIR /app
COPY --from=builder /build/target/release/CloudSidra-Edge /usr/local/bin/cloudsidra-edge
RUN mkdir -p /etc/cloudsidra/edge /var/lib/cloudsidra/edge \
    && chown -R cloudsidra-edge:cloudsidra-edge /var/lib/cloudsidra/edge
# Edge needs NET_BIND_SERVICE / NET_RAW / NET_ADMIN at runtime (compose cap_add).
USER cloudsidra-edge
EXPOSE 80 443 443/udp 19090
# CLOUD_NODE_MODE=standalone, CLOUD_NODE_HOME configured at runtime.
ENTRYPOINT ["/usr/local/bin/cloudsidra-edge"]

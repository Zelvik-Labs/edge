[Unit]
Description=CloudSidra Edge (CDN / global traffic data-plane node)
Documentation=file:/usr/share/doc/cloudsidra-edge/README.md
Wants=network-online.target
After=network-online.target cloudsidra-api.service

[Service]
Type=simple
User=cloudsidra-edge
Group=cloudsidra-edge
# Standalone (single-node) mode is the default. Running the binary with no
# subcommand starts the foreground server (run_node). It reads its runtime and
# api config tree from CLOUD_NODE_HOME / the install dir.
ExecStart=/usr/bin/cloudsidra-edge
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillMode=mixed
KillSignal=SIGTERM

# Edge attaches eBPF (XDP), binds low ports and may raise interface affinity.
# Provide the capabilities it needs; non-root user still applies.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=false
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
# Edge sizing: dedicated CPU/NIC; scale memory/FD per bandwidth (docs/08).
LimitNOFILE=1048576
LimitNPROC=65536
TasksMax=65536
LimitMEMLOCK=infinity
MemoryMax=16G
CPUQuota=800%

Environment=CLOUD_NODE_MODE=standalone
Environment=CLOUD_NODE_HOME=/var/lib/cloudsidra/edge
Environment=CLOUDSIDRA_CONFIG_DIR=/etc/cloudsidra/edge
Environment=CLOUDSIDRA_LOG_FORMAT=json
Environment=TZ=Asia/Shanghai

# node_id / secret / API endpoints rendered by the installer (${NODE_SECRET}).
EnvironmentFile=-/etc/cloudsidra/edge/secrets.env

[Install]
WantedBy=multi-user.target

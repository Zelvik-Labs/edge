[Unit]
Description=Zelvik Edge (CDN / global traffic data-plane node)
Documentation=file:/opt/zelvik/edge/README.install
Wants=network-online.target
After=network-online.target zelvik-api.service

[Service]
Type=simple
User=root
Group=root

# @ZELVIK_EDGE_HOME@ and @ZELVIK_EDGE_BIN@ are substituted by deploy/install.sh
# with the resolved component home and the binary it actually installed
# (<home>/bin/zelvik-edge). Both must be templated: the home is selectable via
# --install-dir, so a hardcoded ExecStart would 203/EXEC or, worse, run a stale
# copy. The wrapper /usr/local/bin/zelvik-edge exports the same home.
WorkingDirectory=@ZELVIK_EDGE_HOME@
Environment=ZELVIK_EDGE_HOME=@ZELVIK_EDGE_HOME@
Environment=TZ=Asia/Shanghai
ExecStart=@ZELVIK_EDGE_BIN@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillMode=mixed
KillSignal=SIGTERM

# Dedicated CDN hosts run Edge as root for XDP, network tuning and supervised
# package upgrades. Keep the normal root capability set and writable install
# paths: upgrades back up under /var/backups/zelvik/edge-upgrade, replace bin/
# and the eBPF object, then ask systemd to restart with rollback supervision.
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=false
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Edge sizing: dedicated CPU/NIC; scale memory/FD per bandwidth (docs/08).
LimitNOFILE=1048576
LimitNPROC=65536
TasksMax=65536
LimitMEMLOCK=infinity
# No fixed MemoryMax: the node sizes its budgets to min(host RAM, cgroup
# limit). A hard cap belongs in a site-specific drop-in, not in the shipped
# unit; the old 16G value silently exceeded small hosts and defeated pressure
# accounting.
CPUQuota=800%

[Install]
WantedBy=multi-user.target

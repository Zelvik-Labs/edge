[Unit]
Description=Zelvik Edge (CDN / global traffic data-plane node)
Documentation=file:/opt/zelvik/edge/README.install
Wants=network-online.target
After=network-online.target zelvik-api.service

[Service]
Type=simple
User=zelvik-edge
Group=zelvik-edge

# @ZELVIK_EDGE_HOME@ and @ZELVIK_EDGE_BIN@ are substituted by deploy/install.sh
# with the resolved component home and the binary it actually installed
# (<home>/bin/zelvik-edge). Both must be templated: the home is selectable via
# --install-dir, so a hardcoded ExecStart would 203/EXEC or, worse, run a stale
# copy. The wrapper /usr/local/bin/zelvik-edge exports the same home.
WorkingDirectory=@ZELVIK_EDGE_HOME@
Environment=ZELVIK_EDGE_HOME=@ZELVIK_EDGE_HOME@
Environment=TZ=Asia/Shanghai
ExecStart=@ZELVIK_EDGE_BIN@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillMode=mixed
KillSignal=SIGTERM

# Edge attaches eBPF (XDP), binds low ports and may raise interface affinity.
# Provide the capabilities it needs; non-root user still applies.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=false
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN

# ProtectSystem=strict makes everything read-only. The service user owns only
# data/ (pid file, cache, geo store, control-plane runtime override, upgrade
# requests) and logs/. bin/, configs/, pki/ and backups/ stay root-controlled:
# the node reads them, never writes them. The root upgrade helper is a separate
# unit (zelvik-edge-upgrade.service) and is not granted by this one.
ReadWritePaths=@ZELVIK_EDGE_HOME@/data
ReadWritePaths=@ZELVIK_EDGE_HOME@/logs

# Edge sizing: dedicated CPU/NIC; scale memory/FD per bandwidth (docs/08).
LimitNOFILE=1048576
LimitNPROC=65536
TasksMax=65536
LimitMEMLOCK=infinity
MemoryMax=16G
CPUQuota=800%

[Install]
WantedBy=multi-user.target

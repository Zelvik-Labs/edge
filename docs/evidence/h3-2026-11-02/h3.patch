+    impl Drop for Pair {
+        fn drop(&mut self) {
+            for driver in &self.drivers {
+                driver.abort();
+            }
+            self._client.close(0u32.into(), b"test complete");
+            self._server.close(0u32.into(), b"test complete");
+        }
+    }

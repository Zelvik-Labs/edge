    "returncode": 0
  },
  {
    "name": "clippy-default",
    "command": [
      "/workspace/docs/scripts/workspace/local-rust.sh",
      "clippy",
      "--locked",
      "-p",
      "zelvik-edge-io",
      "--all-targets",
      "--",
      "-D",
      "clippy::correctness",
      "-D",

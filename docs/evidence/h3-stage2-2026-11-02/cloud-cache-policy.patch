+class CloudBudgetProfileTest(unittest.TestCase):
+    def tearDown(self) -> None:
+        storage.configure_budget_profile("local", Path("/tmp"))
+
+    def test_cloud_keeps_large_caches_until_disk_headroom_is_exhausted(self) -> None:
+        capacity = 128 * storage.GIB
+        disk = mock.Mock(total=capacity)
+        with mock.patch.object(storage.shutil, "disk_usage", return_value=disk):
+            storage.configure_budget_profile("cloud", Path("/tmp"))
+        sizes = {name: 0 for name in storage.CATEGORY_NAMES}
+        sizes["mbx"] = 64 * storage.GIB
+        self.assertEqual(storage.budget_reasons(sizes), [])
+        self.assertEqual(storage.TOTAL_CAP, capacity)
+        self.assertEqual(storage.CATEGORY_BUDGETS["mbx"], capacity)
+        self.assertIsNotNone(storage.free_reason(storage.MIN_FREE - 1))
+        self.assertIsNotNone(storage.free_reason(storage.MIN_FREE + storage.START_MARGIN - 1, True))
+
+    def test_local_profile_restores_laptop_quotas(self) -> None:
+        with mock.patch.object(storage.shutil, "disk_usage", return_value=mock.Mock(total=128 * storage.GIB)):
+            storage.configure_budget_profile("cloud", Path("/tmp"))
+        storage.configure_budget_profile("local", Path("/tmp"))
+        self.assertEqual(storage.CATEGORY_BUDGETS, storage.DEFAULT_CATEGORY_BUDGETS)
+        self.assertEqual(storage.TOTAL_CAP, 24 * storage.GIB)
+        self.assertTrue(storage.budget_reasons({"mbx": 13 * storage.GIB}))
+
+    def test_invalid_profile_is_rejected_without_changing_budgets(self) -> None:
+        before = dict(storage.CATEGORY_BUDGETS)
+        with self.assertRaises(ValueError):
+            storage.configure_budget_profile("unknown", Path("/tmp"))
+        self.assertEqual(storage.CATEGORY_BUDGETS, before)
+
+    def test_workspace_cloud_selection_persists_but_explicit_local_wins(self) -> None:
+        with tempfile.TemporaryDirectory() as directory, mock.patch.dict(os.environ):
+            workspace = Path(directory)
+            os.environ.pop("ZELVIK_LOCAL_STORAGE_PROFILE", None)
+            self.assertEqual(storage.selected_budget_profile(workspace), "local")
+            (workspace / ".local").mkdir()
+            (workspace / ".local/storage-profile").write_text("cloud\n")
+            self.assertEqual(storage.selected_budget_profile(workspace), "cloud")
+            os.environ["ZELVIK_LOCAL_STORAGE_PROFILE"] = "local"
+            self.assertEqual(storage.selected_budget_profile(workspace), "local")
+

+
+def selected_budget_profile(workspace: Path) -> str:
+    explicit = os.environ.get("ZELVIK_LOCAL_STORAGE_PROFILE")
+    if explicit is not None:
+        return explicit
+    selector = workspace / ".local/storage-profile"
+    return selector.read_text().strip() if selector.exists() else "local"
+
+
+def configure_budget_profile(profile: str, workspace: Path) -> None:
+    """Cloud caches use available disk capacity instead of laptop quotas."""
+    global TOTAL_CAP, BUDGET_PROFILE
+    if profile not in {"local", "cloud"}:
+        raise ValueError("ZELVIK_LOCAL_STORAGE_PROFILE must be local or cloud")
+    if profile == "cloud":
+        capacity = shutil.disk_usage(workspace).total
+        budgets = {name: capacity for name in CATEGORY_NAMES}
+        total = capacity
+    else:
+        budgets = DEFAULT_CATEGORY_BUDGETS
+        total = DEFAULT_TOTAL_CAP
+    CATEGORY_BUDGETS.clear()
+    CATEGORY_BUDGETS.update(budgets)
+    TOTAL_CAP = total
+    BUDGET_PROFILE = profile
 
